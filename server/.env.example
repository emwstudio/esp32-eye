# esp32-eye 服务端配置
# 复制为 .env 并填写

# CAM 板地址（mDNS 或固定 IP）
CAM_BASE_URL=http://catcam.local

# CAM 音频 WS 地址（固件 WS 音频在 81 端口）
# 留空时从 CAM_BASE_URL 自动推导：ws://<host>:81/audio
CAM_AUDIO_WS_URL=

# 本地门控模型（llama.cpp llama-server，OpenAI 兼容）
GATE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
GATE_MODEL_NAME=MiniCPM-V-4.7-1B
GATE_MODEL_API_KEY=none

# 云端身份确认模型（ModelBest）
ID_MODEL_BASE_URL=https://api.modelbest.cn/v1
ID_MODEL_NAME=MiniCPM-V-4.7-35B-A3B
ID_MODEL_API_KEY=

# 门控参数
OCCUPANCY_PREFILTER_RATIO=0.15 # 前景占比超过才调 1B（低于直接否定票）
OCCUPANCY_RATIO_THRESHOLD=0.35   # 前景占比超过才算"猫占满画面"（与 1B 判定相与）
GATE_INTERVAL_S=1.5            # 占比投票间隔（秒）
TRIGGER_CONSECUTIVE=3          # 连续 N 次肯定触发事件
RELEASE_CONSECUTIVE=4          # 连续 M 次否定结束事件
IDENTITY_CONFIDENCE_MIN=0.6    # 低于此置信度标记 unknown

# 存储
DATA_DIR=data
RING_BUFFER_S=40               # 环形缓冲秒数
CLIP_PRE_S=5                   # 片段含事件前 5 秒
CLIP_POST_S=3                  # 事件结束后 3 秒
